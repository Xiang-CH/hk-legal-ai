// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/prisma/client"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClicPage {
  id                    Int      @id @default(autoincrement())
  nid                   Int // page_nid
  title                 String
  content               String   @db.Text
  topic                 String
  languageCode          String // "en", "sc", "tc"
  url                   String
  path                  String
  contextualInformation String   @db.Text
  lastUpdatedAt         DateTime @updatedAt

  referencingPages               ClicPage[]           @relation("ClicPageRelationToClicPage")
  referencedByPages              ClicPage[]           @relation("ClicPageRelationToClicPage")
  referencingLegislationSections LegislationSection[]
  referencingLegislationCaps     LegislationCap[]
  referencingJudgments           Judgment[]
  chunks                         ClicChunk[]

  @@unique([nid, languageCode])
  @@index([nid, languageCode])
}

model LegislationSection {
  id                   Int            @id @default(autoincrement())
  path                 String // cap_no/section_no or cap_no/section_no/subsection_no
  parentLegislationCap LegislationCap @relation("ParentCap", fields: [capNumber, languageCode], references: [capNumber, languageCode], onDelete: NoAction, onUpdate: NoAction)

  capNumber        String
  sectionHeading   String?
  sectionNumber    String
  subsectionNumber String?
  content          String  @db.Text
  languageCode     String // "en", "sc", "tc"
  url              String
  eLegislationUrl  String?

  referencedByClicPages           ClicPage[]
  referencingLegislationSections  LegislationSection[] @relation("LegislationSectionToLegislationSection")
  referencedByLegislationSections LegislationSection[] @relation("LegislationSectionToLegislationSection")
  referencingLegislationCaps      LegislationCap[]     @relation("LegislationSectionToLegislationCap")
  referencedByJudgments           Judgment[]
  relatedInterpretations          Interpretation[]
  chunks                          LegislationChunk[]
  referencedByJudgmentReferences JudgmentLegislationReference[]
  managedJudgmentLinks JudgmentManagedLegislationLink[]

  @@unique([id, languageCode])
  @@index([capNumber, sectionNumber, subsectionNumber, languageCode])
}

model LegislationCap {
  id              Int      @id @default(autoincrement())
  capNumber       String
  title           String?
  longTitle       String?  @db.Text
  languageCode    String // "en", "sc", "tc"
  url             String
  eLegislationUrl String?
  updatedAt       DateTime @updatedAt

  childSections                   LegislationSection[] @relation("ParentCap")
  referencedByLegislationSections LegislationSection[] @relation("LegislationSectionToLegislationCap")
  referencedByJudgments           Judgment[]
  referencedByJudgmentReferences JudgmentLegislationReference[]
  managedJudgmentLinks JudgmentManagedLegislationLink[]
  relatedInterpretations          Interpretation[]
  referencedByClicPages           ClicPage[]

  @@unique([capNumber, languageCode])
  @@index([capNumber, languageCode])
}

model Interpretation {
  id             Int    @id @default(autoincrement())
  term           String
  termDefinition String @db.Text
  languageCode   String // "en", "sc", "tc"

  parentLegislationCap   LegislationCap       @relation(fields: [capNumber, languageCode], references: [capNumber, languageCode], onDelete: NoAction, onUpdate: NoAction)
  capNumber              String
  sectionsContainingTerm LegislationSection[]

  @@index([capNumber, term, languageCode])
}

model Judgment {
  document                       JudgmentDocument?
  id                             Int                  @id
  neutralCitation                String
  courtName                      String
  year                           Int
  number                         Int
  date                           DateTime
  languageCode                   String // "en", "sc", "tc"
  isTranslation                  Boolean
  coram                          String?              @db.Text
  parties                        String?              @db.Text
  representations                String?              @db.Text
  charges                        String?              @db.Text
  remarks                        String?              @db.Text
  summary                        String?              @db.Text
  summarySource                  String? // e.g. "GENERATED", "DOJ", "TEXTBOOK"
  legalrefUrl                    String
  url                            String
  citationIndex                  Int?
  inTextbook                     Boolean              @default(false)
  cases                          Case[]
  referencedByClicPages          ClicPage[]
  referencingLegislationSections LegislationSection[]
  referencingLegislationCaps     LegislationCap[]
  referencingJudgments           Judgment[]           @relation("JudgmentToJudgment")
  referencedByJudgments          Judgment[]           @relation("JudgmentToJudgment")
  parallelCitations              ParallelCitations[]
  chunks                         JudgmentChunk[]
  citationAliases                JudgmentCitationAlias[]
  outgoingReferences             JudgmentReference[] @relation("JudgmentReferenceSource")
  incomingReferences             JudgmentReference[] @relation("JudgmentReferenceTarget")
  legislationReferences          JudgmentLegislationReference[]
  managedLegislationLinks JudgmentManagedLegislationLink[]
  fulltextChunks                 JudgmentFulltextChunk[]
}

model ParallelCitations {
  id           Int      @id
  citation     String
  languageCode String // "en", "sc", "tc"
  judgment     Judgment @relation(fields: [judgmentId], references: [id])
  judgmentId   Int
}

model Case {
  id      Int    @id
  caseAct String @unique
  actType String
  year    Int
  number  Int
  title   String
  cjrId   Int
  cjrDis  Int

  judgments Judgment[]
}

model LegislationChunk {
  id               BigInt                        @id @default(autoincrement())
  sectionId        Int                           @map("section_id")
  chunkNo          Int                           @map("chunk_no")
  languageCode     String                        @map("language_code") // "en", "sc", "tc"
  capNumber        String                        @map("cap_number")
  sectionNumber    String                        @map("section_number")
  subsectionNumber String?                       @map("subsection_number")
  heading          String?
  content          String                        @db.Text
  url              String
  context          String?                       @db.Text
  embedding        Unsupported("halfvec(3072)")?
  tsv              Unsupported("tsvector")?
  cjkTokens        String?                       @map("cjk_tokens") @db.Text
  section          LegislationSection            @relation(fields: [sectionId, languageCode], references: [id, languageCode], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sectionId, languageCode, chunkNo])
  @@index([sectionId, languageCode])
  @@map("legislation_chunks")
}

model ClicChunk {
  id           BigInt                        @id @default(autoincrement())
  nid          Int
  chunkNo      Int                           @map("chunk_no")
  languageCode String                        @map("language_code") // "en", "sc", "tc"
  title        String
  content      String                        @db.Text
  url          String
  topic        String
  context      String?                       @db.Text
  embedding    Unsupported("halfvec(3072)")?
  tsv          Unsupported("tsvector")?
  cjkTokens    String?                       @map("cjk_tokens") @db.Text
  page         ClicPage                      @relation(fields: [nid, languageCode], references: [nid, languageCode], onDelete: Cascade, onUpdate: NoAction)

  @@unique([nid, languageCode, chunkNo])
  @@index([nid, languageCode])
  @@map("clic_chunks")
}

model ChatUsageEvent {
  id         String  @id @default(cuid())
  sessionId  String  @map("session_id")
  turnIndex  Int     @map("turn_index")
  previousId String? @unique @map("previous_id")

  previous ChatUsageEvent? @relation("ChatUsageEventChain", fields: [previousId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  next     ChatUsageEvent? @relation("ChatUsageEventChain")

  ipHash        String?  @map("ip_hash")
  userAgent     String?  @map("user_agent")
  domain        String?
  searchMode    String   @map("search_mode") // "agent" | "legacy"
  model         String?
  stepCount     Int?     @map("step_count")
  toolCallCount Int?     @map("tool_call_count")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  totalTokens   Int?     @map("total_tokens")
  costUsd       Decimal? @map("cost_usd") @db.Decimal(12, 6)
  latencyMs     Int?     @map("latency_ms")
  question      String   @db.Text
  answer        String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([sessionId, turnIndex])
  @@index([sessionId, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
  @@map("chat_usage_events")
}

model JudgmentChunk {
  id              BigInt                        @id @default(autoincrement())
  judgmentId      Int                           @map("judgment_id")
  chunkNo         Int                           @map("chunk_no")
  languageCode    String                        @map("language_code") // "en", "sc", "tc"
  neutralCitation String?                       @map("neutral_citation")
  courtName       String?                       @map("court_name")
  year            Int?
  date            DateTime?
  parties         String?                       @db.Text
  content         String                        @db.Text
  summarySource   String?                       @map("summary_source")
  url             String?
  embedding       Unsupported("halfvec(3072)")?
  tsv             Unsupported("tsvector")?
  cjkTokens       String?                       @map("cjk_tokens") @db.Text
  judgment        Judgment                      @relation(fields: [judgmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([judgmentId, chunkNo])
  @@index([judgmentId])
  @@map("judgment_chunks")
}

model JudgmentDocument {
  id             BigInt              @id @default(autoincrement())
  judgmentId     Int                 @unique @map("judgment_id")
  sourcePath     String              @unique @map("source_path")
  sourceChecksum String              @map("source_checksum")
  rawHtml        String              @map("raw_html") @db.Text
  plainText      String              @map("plain_text") @db.Text
  parserVersion  String              @map("parser_version")
  generation     String              @db.Uuid
  importedAt     DateTime            @default(now()) @map("imported_at") @db.Timestamptz(6)
  judgment       Judgment            @relation(fields: [judgmentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  paragraphs     JudgmentParagraph[]
  fulltextChunks JudgmentFulltextChunk[]
  activeFulltext JudgmentFulltextActive?

  @@unique([id, judgmentId])
  @@map("judgment_documents")
}

model JudgmentParagraph {
  id         BigInt           @id @default(autoincrement())
  documentId BigInt           @map("document_id")
  position   Int
  label      String?
  anchor     String?
  blockType  String           @map("block_type")
  content    String           @db.Text
  html       String?          @db.Text
  document   JudgmentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referenceOccurrences JudgmentReferenceOccurrence[]

  @@unique([documentId, position])
  @@map("judgment_paragraphs")
}

model JudgmentImportRun {
  id            String               @id @db.Uuid
  root          String
  parserVersion String               @map("parser_version")
  status        String
  startedAt     DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?            @map("completed_at") @db.Timestamptz(6)
  files         JudgmentImportFile[]

  @@map("judgment_import_runs")
}

model JudgmentImportFile {
  id             BigInt            @id @default(autoincrement())
  runId          String            @map("run_id") @db.Uuid
  sourcePath     String            @map("source_path")
  sourceChecksum String?           @map("source_checksum")
  status         String
  attempts       Int               @default(1)
  error          String?           @db.Text
  completedAt    DateTime          @default(now()) @map("completed_at") @db.Timestamptz(6)
  run            JudgmentImportRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([runId, sourcePath])
  @@map("judgment_import_files")
}

model JudgmentCitationAlias {
  id         BigInt   @id @default(autoincrement())
  judgmentId Int      @map("judgment_id")
  original   String   @db.Text
  normalized String   @db.Text
  provenance Json
  judgment   Judgment @relation(fields: [judgmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([judgmentId, normalized, original])
  @@index([normalized])
  @@map("judgment_citation_aliases")
}

model JudgmentReference {
  id          BigInt   @id @default(autoincrement())
  sourceId    Int      @map("source_id")
  kind        String   @db.Text
  original    String   @db.Text
  normalized  String   @db.Text
  status      String   @db.Text
  targetId    Int?     @map("target_id")
  candidates  Json     @default("[]")
  provenance  Json
  resolverVersion String @map("resolver_version") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  source      Judgment @relation("JudgmentReferenceSource", fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  target      Judgment? @relation("JudgmentReferenceTarget", fields: [targetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  occurrences JudgmentReferenceOccurrence[]

  @@unique([sourceId, kind, normalized])
  @@index([targetId])
  @@index([normalized])
  @@map("judgment_references")
}

model JudgmentReferenceOccurrence {
  id          BigInt @id @default(autoincrement())
  referenceId BigInt @map("reference_id")
  evidenceKey String @map("evidence_key") @db.Text
  paragraphId BigInt? @map("paragraph_id")
  anchor      String? @db.Text
  evidence    Json
  reference   JudgmentReference @relation(fields: [referenceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  paragraph   JudgmentParagraph? @relation(fields: [paragraphId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([referenceId, evidenceKey])
  @@index([paragraphId])
  @@map("judgment_reference_occurrences")
}

model JudgmentLegislationReference {
  id          BigInt @id @default(autoincrement())
  sourceId    Int @map("source_id")
  original    String @db.Text
  normalized  String @db.Text
  status      String @db.Text
  capId       Int? @map("cap_id")
  sectionId   Int? @map("section_id")
  candidates  Json @default("[]")
  provenance  Json
  source      Judgment @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cap         LegislationCap? @relation(fields: [capId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  section     LegislationSection? @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sourceId, normalized])
  @@index([capId])
  @@index([sectionId])
  @@map("judgment_legislation_references")
}

model JudgmentFulltextChunk {
  id                 BigInt @id @default(autoincrement())
  judgmentId         Int @map("judgment_id")
  documentId         BigInt @map("document_id")
  documentGeneration String @map("document_generation") @db.Text
  generation         String @db.Text
  chunkNo            Int @map("chunk_no")
  languageCode       String @default("en") @map("language_code") @db.Text
  neutralCitation    String? @map("neutral_citation") @db.Text
  courtName          String? @map("court_name") @db.Text
  year               Int?
  date               DateTime? @db.Timestamptz(6)
  parties            String? @db.Text
  summarySource      String? @map("summary_source") @db.Text
  url                String? @db.Text
  content            String @db.Text
  embeddingInput     String @map("embedding_input") @db.Text
  contentChecksum    String @map("content_checksum") @db.Text
  inputChecksum      String @map("input_checksum") @db.Text
  chunkerVersion     String @map("chunker_version") @db.Text
  startPosition      Int @map("start_position")
  endPosition        Int @map("end_position")
  startOffset        Int @map("start_offset")
  endOffset          Int @map("end_offset")
  spans              Json
  tokenCount         Int @map("token_count")
  model              String @db.Text
  deployment         String @db.Text
  modelVersion       String @map("model_version") @db.Text
  status             String @default("pending") @db.Text
  attempts           Int @default(0)
  error              String? @db.Text
  embedding          Unsupported("halfvec(3072)")?
  tsv                Unsupported("tsvector")?
  cjkTokens          String @map("cjk_tokens") @db.Text
  judgment           Judgment @relation(fields: [judgmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document           JudgmentDocument @relation(fields: [documentId, judgmentId], references: [id, judgmentId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([documentId, generation, chunkNo])
  @@index([documentId, generation, status])
  @@index([inputChecksum, model, deployment, modelVersion])
  @@map("judgment_fulltext_chunks")
}

model JudgmentFulltextActive {
  documentId BigInt @id @map("document_id")
  generation String @db.Text
  document   JudgmentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("judgment_fulltext_active")
}

model JudgmentManagedLegislationLink {
  id BigInt @id @default(autoincrement())
  sourceId Int @map("source_id")
  capId Int? @map("cap_id")
  sectionId Int? @map("section_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  source Judgment @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cap LegislationCap? @relation(fields: [capId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  section LegislationSection? @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sourceId,capId])
  @@unique([sourceId,sectionId])
  @@map("judgment_managed_legislation_links")
}
