AGENTIC_SEARCH_ENABLED=false
AGENTIC_MAX_STEPS=5

# Anonymous usage logging (chat_usage_events) is production-only. Set this to
# keep stored IP hashes unguessable.
USAGE_LOG_IP_SALT=

LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=
LANGFUSE_RELEASE=

# Staff-only content dashboard. Use a random key of at least 24 characters.
# Never prefix this variable with NEXT_PUBLIC_. Requests are denied when unset.
CLIC_CONTENT_ADMIN_TOKEN=
